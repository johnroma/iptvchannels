{
  "name": "iptvchannels",
  "version": "1.0.1",
  "description": "IPTV Channel Management - TanStack Start + Drizzle + Supabase",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "predev": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true",
    "dev": "dotenv -e ../env-profiles/local.env -- vite dev --strictPort",
    "dev:prod": "dotenv -e ../env-profiles/prod.env -- vite dev --strictPort",
    "build": "pnpm build:local",
    "build:local": "dotenv -e ../env-profiles/local.env -- vite build",
    "build:prod": "dotenv -e ../env-profiles/prod.env -- vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "db:generate": "dotenv -e ../env-profiles/local.env -- drizzle-kit generate",
    "db:migrate": "dotenv -e ../env-profiles/local.env -- drizzle-kit migrate",
    "db:migrate:prod": "dotenv -e ../env-profiles/prod.env -- drizzle-kit migrate",
    "db:push": "dotenv -e ../env-profiles/local.env -- drizzle-kit push",
    "db:push:prod": "dotenv -e ../env-profiles/prod.env -- drizzle-kit push",
    "db:studio": "dotenv -e ../env-profiles/local.env -- drizzle-kit studio",
    "db:studio:prod": "dotenv -e ../env-profiles/prod.env -- drizzle-kit studio",
    "db:seed:channels": "./scripts/seed-channels.sh local ../assets/seedlocal.m3u",
    "db:seed:channels:prod": "./scripts/seed-channels.sh prod ../assets/seedprod.m3u",
    "db:seed:media": "./scripts/seed-media.sh local ../assets/seedlocal.m3u",
    "db:seed:media:prod": "./scripts/seed-media.sh prod ../assets/seedprod.m3u",
    "db:reset": "dotenv -e ../env-profiles/local.env -- tsx src/db/reset.ts",
    "db:reset:prod": "dotenv -e ../env-profiles/prod.env -- tsx src/db/reset.ts",
    "db:psql": "dotenv -e ../env-profiles/local.env -- psql",
    "db:psql:prod": "dotenv -e ../env-profiles/prod.env -- psql",
    "supabase": "dotenv -e ../env-profiles/supabase.env -- supabase",
    "sb:status": "dotenv -e ../env-profiles/supabase.env -- supabase inspect db table-stats --linked",
    "ui:add": "pnpm -F ui ui:add",
    "test": "vitest",
    "test:run": "vitest run",
    "verify:maintenance": "bash scripts/verify-maintenance.sh"
  },
  "keywords": [
    "iptv",
    "channels",
    "tanstack",
    "drizzle",
    "supabase"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "latest",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.4",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.7",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "lucide-react": "^1.77.0",
    "nitro": "^3.0.260610-beta",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/react-query-devtools": "^5.108.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dotenv": "^18.0.10",
    "dotenv-cli": "^11.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [],
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
