# .understandignore — patterns for files/dirs to exclude from analysis
# Syntax: same as .gitignore (globs, # comments, ! negation, trailing / for dirs)
#
# Built-in defaults (always excluded unless negated):
#   node_modules/, .git/, dist/, build/, obj/, *.lock, *.min.js, *.map, etc.
#

# --- Active exclusions (build artifacts & duplicates that would create noise) ---

# This tool's own output directory — never analyze itself
.understand-anything/

# Empty git marker files
.gitkeep

# Supabase CLI internal state
supabase/.branches/
supabase/.temp/

# Nested untracked copy of the repo (0 git-tracked files) — would duplicate every node
iptvchannels/

# Nitro / TanStack Start build output
.output/
.tanstack/
.vinxi/

# TanStack Start generated server-routes output (mirrors src/routes)
server/routes/

# TypeScript incremental build info
*.tsbuildinfo

# routeTree is auto-generated by TanStack Router (mirrors src/routes)
src/routeTree.gen.ts

# --- From .gitignore (already excluded by defaults or not present; uncomment to be explicit) ---

# env-profiles/*.env
# !env-profiles/.env.example
# .env
# .env.*
# !.env.example
# storybook-static/
# drizzle/meta/
# supabase/.temp/
# .DS_Store
# Thumbs.db
# *.swp
# *.swo
# npm-debug.log*
# pnpm-debug.log*
# .vercel

# --- Detected directories (uncomment to exclude) ---

# scripts/          # bash/awk M3U seeders — currently included as 'script' files

# --- Test file patterns (uncomment to exclude) ---

# *.test.*
# *.spec.*
# *.snap
